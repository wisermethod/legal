        {
          "item": "Response and packet certificate",
          "method": "Court Filing",
          "notes": "Verify in the governing materials that the response's certificate covers the declaration.",
          "citation": null,
          "verification": "verify"
        }
      ],
      "post_filing_steps": [],
      "notes": [
        "Keep the declaration with the verified enclosing packet."
      ]
    }
  },
