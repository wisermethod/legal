{
  "jurisdiction_id": "colorado-district",
  "display_name": "Colorado District Court",
  "renderer_profile": "colorado-two-column-boxed",
  "court_match": [
    "District Court, [^\\s,](?:[^,]*[^\\s,])? County, Colorado",
    "District Court, City and County of [^\\s,](?:[^,]*[^\\s,])?, Colorado"
  ],
  "layout": {
    "page_size": "Letter",
    "margins_inches": {
      "top": 1,
      "right": 1,
      "bottom": 1,
      "left": 1
    },
    "body_font": "Times New Roman",
    "body_font_size_pt": 12,
    "body_line_height": 2,
    "footer": {
      "format": "Page {page} of {pages}",
      "font": "Times New Roman",
      "size_pt": 10,
      "position": "center"
    },
    "caption_style": "Two-column boxed table; left column court and parties; right column COURT USE ONLY box, case number, division",
    "pdf_font_names": [
      "TimesNewRomanPSMT",
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPS-BoldItalicMT"
    ]
  },
  "caption_defaults": {
    "court": "District Court, [County] County, Colorado",
    "court_address": "[Court Address]",
    "parties": [
      {
        "role": "Plaintiff",
        "name": "[Plaintiff Name]"
      },
      {
        "role": "Defendant",
        "name": "[Defendant Name]"
      }
    ],
    "case_number": "[Case Number]",
    "division": "[Division]",
    "title": "Plaintiff's Motion for [Relief]",
    "signer": {
      "name": "[Your Name]",
      "role": "Pro Se [Plaintiff/Defendant]",
      "lines": [
        "[Street Address]",
        "[City, State ZIP]",
        "[Phone]",
        "[Email]"
      ]
    },
    "service": {
      "method": "email",
      "served_by": "[Your Name]",
      "recipients": [
        {
          "name": "[Opposing Counsel Name]",
          "emails": [
            "counsel@example.invalid"
          ]
        }
      ],
      "firm": "[Law Firm Name]",
      "firm_lines": [
        "[Firm Street Address]",
        "[City, State ZIP]"
      ],
      "firm_note": "Attorneys for [Party Name]"
    },
    "document_type": "motion",
    "counsel_label": "[Counsel Label]:"
  },
  "validation": {
    "limits": {
      "general-motion-pages": {
        "unit": "pages",
        "maximum": 15,
        "citation": "C.R.C.P. 121 section 1-15(1)(a)",
        "verification": "working-default"
      },
      "rule-12-or-56-motion-pages": {
        "unit": "pages",
        "maximum": 25,
        "citation": "C.R.C.P. 121 section 1-15(1)(a)",
        "verification": "working-default"
      },
      "general-reply-pages": {
        "unit": "pages",
        "maximum": 10,
        "citation": "C.R.C.P. 121 section 1-15(1)(a)",
        "verification": "working-default"
      },
      "rule-12-or-56-reply-pages": {
        "unit": "pages",
        "maximum": 15,
        "citation": "C.R.C.P. 121 section 1-15(1)(a)",
        "verification": "working-default"
      }
    },
    "exclusions": [
      "case caption",
      "signature block",
      "certificate of service",
      "attachments"
    ],
    "notes": [
      "These are page limits. Unless the court orders otherwise, general motions and responses use the general motion page limit and general replies use the general reply page limit. The separate page limits apply to motions, responses and replies under C.R.C.P. 12(b)(1), 12(b)(2), or 56.",
      "The rule excludes the case caption, signature block, certificate of service and attachments. Confirm the applicable page limit against the current rule and any court order before filing."
    ]
  },
  "rules": [
    {
      "citation": "C.R.C.P. 10",
      "verification": "working-default",
      "notes": "Use a two-column boxed caption with court and parties on the left and COURT USE ONLY, case number, and division on the right. Supply the address of the court on the docket."
    },
    {
      "citation": "C.R.C.P. 10(d)",
      "verification": "working-default",
      "notes": "The working layout calls for at least 1-inch margins, 12-point type, and double spacing, with exceptions such as footnotes and block quotes. This profile sets Letter paper, one-inch margins, and Times New Roman 12-point double-spaced prose. Verify whether the spacing rule applies to tables, lists and headings. Inspect the reported density of those elements in preview."
    },
    {
      "citation": "C.R.C.P. 121 section 1-15(1)(a)",
      "verification": "working-default",
      "notes": "Working page limits and exclusions are in validation. Confirm the current rule and any applicable court order before filing."
    },
    {
      "citation": null,
      "verification": "working-default",
      "notes": "The renderer leaves the signature date and the certificate day and month blank for manual completion immediately before filing via Colorado CCEF. The certificate preprints the caption year if supplied or the current calendar year."
    }
  ],
  "filing_packets": {
    "new_case_complaint": {
      "description": "Court Filing packet for composing an initial complaint.",
      "required_at_filing": [
        {
          "item": "Complaint",
          "method": "Court Filing",
          "notes": "Court Filing composes the complaint from the body Markdown and caption data.",
          "citation": null,
          "verification": "working-default"
        }
      ],
      "post_filing_steps": [],
      "notes": []
    },
