        "[Street Address]",
        "[City, State ZIP]",
        "[Phone]",
        "[Email]"
      ]
    },
    "service": {
      "method": "email",
      "served_by": "[Your Name]",
      "recipients": [
        {
          "name": "[Opposing Counsel Name]",
          "emails": [
            "counsel@example.invalid"
          ]
        }
      ],
      "firm": "[Law Firm Name]",
      "firm_lines": [
        "[Firm Street Address]",
        "[City, State ZIP]"
      ],
      "firm_note": "Attorneys for [Party Name]"
    },
    "document_type": "motion",
    "counsel_label": "[Counsel Label]:"
  },
  "validation": {
    "limits": {
      "general-motion-pages": {
        "unit": "pages",
        "maximum": 15,
        "citation": "C.R.C.P. 121 section 1-15(1)(a)",
        "verification": "working-default"
      },
      "general-motion-words": {
        "unit": "words",
        "maximum": 4000,
        "citation": "C.R.C.P. 121 section 1-15(1)(a)",
        "verification": "working-default"
      },
      "rule-12-or-56-motion-pages": {
        "unit": "pages",
        "maximum": 25,
        "citation": "C.R.C.P. 121 section 1-15(1)(a)",
        "verification": "working-default"
      },
      "general-reply-pages": {
        "unit": "pages",
        "maximum": 10,
        "citation": "C.R.C.P. 121 section 1-15(1)(a)",
        "verification": "working-default"
      },
      "general-reply-words": {
        "unit": "words",
        "maximum": 2500,
        "citation": "C.R.C.P. 121 section 1-15(1)(a)",
        "verification": "working-default"
      },
      "rule-12-or-56-reply-pages": {
        "unit": "pages",
        "maximum": 15,
        "citation": "C.R.C.P. 121 section 1-15(1)(a)",
        "verification": "working-default"
      }
    },
    "exclusions": [
      "caption",
      "signature block",
      "certificate of service",
      "attachments"
    ],
    "notes": [
      "Use the applicable working page limit unless a verified court order controls. General motions and responses use the general motion presets. The separate motion and reply presets cover C.R.C.P. 12(b)(1), 12(b)(2), and 56.",
      "The general motion and reply word limits are alternatives to the corresponding page limits, with the same exclusions.",
      "Separate word limits remain unconfirmed for C.R.C.P. 12(b)(1), 12(b)(2), and 56 motions. Verify before using a word figure for these filings."
    ]
  },
  "rules": [
    {
      "citation": "C.R.C.P. 10",
      "verification": "working-default",
      "notes": "Use a two-column boxed caption with court and parties on the left and COURT USE ONLY, case number, and division on the right. Supply the address of the court on the docket."
    },
    {
      "citation": "C.R.C.P. 10(d)",
      "verification": "working-default",
      "notes": "The working layout calls for at least 1-inch margins, 12-point type, and double spacing, with exceptions such as footnotes and block quotes. This profile sets Letter paper, one-inch margins, and Times New Roman 12-point double-spaced prose. Verify whether the spacing rule applies to tables, lists and headings. Inspect the reported density of those elements in preview."
    },
    {
      "citation": "C.R.C.P. 121 section 1-15(1)(a)",
      "verification": "working-default",
      "notes": "Working limit figures and exclusions are in validation. Verify the rule and any applicable court order before choosing a limit."
    },
    {
      "citation": "C.R.C.P. 121 section 1-15(8)",
      "verification": "working-default",
      "notes": "Confirm the requirement for good-faith conferral with opposing counsel before filing most motions. State conferral in the body when required."
    },
    {
      "citation": null,
      "verification": "working-default",
      "notes": "The renderer leaves the signature date and the certificate day and month blank for manual completion immediately before filing via Colorado CCEF. The certificate preprints the caption year if supplied or the current calendar year."
    },
    {
      "citation": "C.R.C.P. 121 section 1-15(1)(a)",
      "verification": "verify",
      "notes": "Word limits for the listed C.R.C.P. 12 and 56 motion classes remain unconfirmed."
    }
  ],
